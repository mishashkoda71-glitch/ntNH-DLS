<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.ntnh_dls">

    <!-- 1. Разрешение на отрисовку поверх других приложений -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 2. Разрешение "видеть" установленные игры (Android 11+) -->
    <queries>
        <package android:name="com.axlebolt.standoff2" />
    </queries>

    <application
        android:label="ntNH-DLS"
        android:theme="@android:style/Theme.DeviceDefault">
        
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <service android:name=".OverlayService" android:exported="false" />
    </application>
</manifest>
